mode: distributed
replicas: 4
persistence:
  enabled: true
  size: 250Gi
rootUser: "{{ env "MINIO_ROOT_USER" | default "minioadmin" }}"
rootPassword: "{{ env "MINIO_ROOT_PASSWORD" | default "minioadmin" }}"
resources: {}
ingress:
  enabled: true
  hosts:
    - minio.{{ .Environment.Values.baseDomain }}
metrics:
  serviceMonitor:
    enabled: true
